{
  "name": "@zanix/utils",
  "version": "4.4.0",
  "license": "MIT",
  // Stays "auto", not "manual"/"none" — tried "manual" as a hygiene guard (this repo has zero real
  // `npm:` package dependencies, confirmed via `deno.lock` carrying no `npm:` entries at all), but
  // reverted: `deno check`/`deno test` broke outright under "manual" — `src/utils/cron.ts`'s real
  // `import { setImmediate } from 'node:timers'` needs `@types/node` resolvable to type-check
  // (a `node:` built-in specifier is a real, legitimate Deno Node-compat import, not an `npm:`
  // package, but its TYPE declarations still come from `@types/node` under node_modules), and
  // "auto" is what silently keeps that satisfied today. Adopting "manual" would require also
  // explicitly declaring `@types/node` and committing to `deno install` as a real process change —
  // out of scope for this pass. `nodeModulesDir` only governs THIS repo's own root/workspace
  // resolution either way — Deno's own docs confirm it never affects a downstream consumer's
  // separate `node_modules`, so this was never a fix for the over-materialization behavior
  // `lazy-import.ts` exists to let CONSUMERS avoid (that always lives on the consumer's own side).
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "types": ["./src/typings/index.d.ts"]
  },
  "exports": {
    "./linter/deno-fmt-plugin": "./src/modules/linter/plugins/format/mod.ts",
    "./linter/deno-std-plugin": "./src/modules/linter/plugins/standard/mod.ts",
    "./linter/deno-test-plugin": "./src/modules/linter/plugins/test/mod.ts",
    "./linter/deno-zanix-plugin": "./src/modules/linter/plugins/zanix/mod.ts",
    "./constants": "./src/modules/constants/mod.ts",
    "./helpers": "./src/modules/helpers/mod.ts",
    "./validator": "./src/modules/validations/mod.ts",
    "./logger": "./src/modules/logger/mod.ts",
    "./logger/client": "./src/modules/logger/main.ts",
    "./regex": "./src/modules/regex/mod.ts",
    "./testing": "./src/modules/testing/mod.ts",
    "./workers": "./src/modules/workers/mod.ts",
    "./errors": "./src/modules/errors/mod.ts",
    "./types": "./src/modules/types/mod.ts"
  },
  "publish": {
    "exclude": [".github", "src/@tests"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended", "jsr"],
      "include": [
        "eqeqeq",
        "default-param-last",
        "camelcase",
        "no-await-in-loop",
        "no-const-assign",
        "no-eval",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-self-compare",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-useless-rename"
      ]
    },
    "exclude": [".dist/"],
    "plugins": [
      // Using the jsr: specifier (not the local "./src/modules/linter/plugins/zanix/mod.ts" path)
      // because the vscode-deno language server doesn't load lint plugins from a local relative
      // path — even after an LSP restart. `deno lint`/`deno publish` work fine with the local path,
      // but editor diagnostics need the resolved jsr specifier.
      "jsr:@zanix/utils@^4.0.0/linter/deno-zanix-plugin"
    ],
    "report": "pretty"
  },
  "fmt": {
    "exclude": [".dist/"],
    "proseWrap": "preserve",
    "indentWidth": 2,
    "singleQuote": true,
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": false
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@0.224",
    "@std/crypto": "jsr:@std/crypto@^1.1.0",
    "@std/testing": "jsr:@std/testing@1.0.9",
    "@std/fmt": "jsr:@std/fmt@0.224",
    "@std/fs": "jsr:@std/fs@0.224",
    "@std/path": "jsr:@std/path@0.224",
    "linter/": "./src/linter/",
    "typings/": "./src/typings/",
    "utils/": "./src/utils/",
    "modules/": "./src/modules/"
  },
  "zanix": {
    "project": "library"
  },
  "test": {
    "include": [
      "src/@tests/**/*.test.ts"
    ]
  },
  // "worker-options" backs `Worker`'s `deno: { permissions }` — required for the sandboxing
  // permissions restriction feature (see src/modules/workers/processor.ts) to run at all, in
  // consumers and in this package's own tests alike, until Deno stabilizes the API.
  "unstable": ["worker-options"]
}
